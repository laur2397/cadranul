# Baza de date PostgreSQL
DATABASE_URI=postgres://postgres@/cadranul?host=/tmp
# Secret lung si aleator (openssl rand -hex 32)
PAYLOAD_SECRET=
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# true = continut demonstrativ, nu se indexeaza nimic, seed-ul are voie sa ruleze
NEXT_PUBLIC_DEMO=true

# Etichete terte: GOALE = nu se incarca nimic. Se incarca doar dupa acordul cititorului (src/client/consimtamant.ts).
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GAM_NETWORK=
NEXT_PUBLIC_ADSENSE_CLIENT=
# JSON: {"acasa-billboard":"1234567890"} (doar pentru AdSense fara Ad Manager)
NEXT_PUBLIC_ADSENSE_SLOTS=
NEXT_PUBLIC_META_PIXEL_ID=
# none (implicit) sau limited: reclame ne-personalizate si dupa „Refuz tot” (decizie a proprietarului, cu avocatul)
NEXT_PUBLIC_ADS_ON_REFUSAL=none
# Liniile din ads.txt, separate prin \n
ADS_TXT_LINES=

# Optional, doar pentru npm run seed: cont de administrator
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Importurile automate de date (npm run surse:worker, docs/fluxuri-date.md)
# Contactul din User-Agent-ul „CadranulBot/1.0 (...)”, ca sursele sa ne poata scrie
SURSE_CONTACT=contact: date@[domeniul-redactiei]
# Unde raspunde site-ul pentru worker (reincarcarea hartii dupa import). Gol = NEXT_PUBLIC_SITE_URL
SURSE_SITE_URL=
# Alerta dupa N esecuri la rand (implicit 3): in jurnal si, optional, POST JSON {text,...} la acest webhook (Slack, Teams, ntfy)
SURSE_ALERT_WEBHOOK=
SURSE_ALERTA_DUPA=3
# Trafic in timp real: TomTom Traffic (cont gratuit pe developer.tomtom.com; docs/fluxuri-date.md, „Trafic in timp real”)
TOMTOM_API_KEY=
# La cate minute (implicit 25 = in planul gratuit de 2.500 de cereri pe zi); mai des se plateste
TOMTOM_MINUTE=
# Comutatorul de urgenta: all = nicio sursa nu ruleaza; sau o lista: anm-avertizari,opcom-pzu
SURSE_OPRITE=
